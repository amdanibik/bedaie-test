APP_KEY	Jalankan php artisan key:generate --show untuk dapatkan valuenya
APP_ENV	production
APP_DEBUG	false
APP_URL	URL Vercel kamu (contoh: https://nama-app.vercel.app)
SESSION_DRIVER	cookie
CACHE_STORE	array
LOG_CHANNEL	stderr
DB_CONNECTION	mysql (atau sesuai database)
DB_HOST	Host cloud database kamu
DB_DATABASE	Nama database
DB_USERNAME	Username database
DB_PASSWORD	Password database